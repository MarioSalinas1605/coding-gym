{
	"name": "coding-gym",
	"type": "module",
	"private": true,
	"workspaces": [
		"src/greatfrontend/*"
	],
	"scripts": {
		"new": "bun scripts/new.ts",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"typecheck": "tsc --noEmit && bun run --workspaces --if-present typecheck",
		"format": "biome check",
		"format:fix": "biome check --write",
		"verify": "bun scripts/verify.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@clack/prompts": "^1.8.1",
		"@happy-dom/global-registrator": "^21.0.4",
		"@types/bun": "latest",
		"@types/turndown": "^5.0.6",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
